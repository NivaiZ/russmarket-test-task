    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.90.0",
    "steiger": "^0.9.0",
    "typescript": "~6.0.3",
